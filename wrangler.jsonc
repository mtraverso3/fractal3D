// Static assets Worker serving the web build at fractal.mtraverso.net
// Build with `web/build.sh`, deploy with `npx wrangler deploy`
{
  "name": "fractal3d",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "fractal.mtraverso.net", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
